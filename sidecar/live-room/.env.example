# 複製成 .env，不要提交 .env
ZEN_BRIDGE_UI_URL=https://vexlark.co
ZEN_BRIDGE_AGENT_URL=wss://vexlark.co/asr-agent
ZEN_BRIDGE_AGENT_TOKEN=
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
BREEZE_TRANSLATE=1
BREEZE_PORT=8780
BREEZE_SHARE_SCHEME=http
BREEZE_SHARE_HOST=
BREEZE_MAX_AUDIO_BYTES=2097152
BREEZE_UPLOAD_READ_TIMEOUT=20
BREEZE_MAX_AUDIO_SECONDS=30
BREEZE_MAX_ROOMS=8
BREEZE_MAX_LISTENERS=40
BREEZE_MAX_QUEUE=8
BREEZE_MAX_INFLIGHT_BYTES=33554432
BREEZE_ASR=native
BREEZE_RESIDENT_URL=http://127.0.0.1:8178
BREEZE_RESIDENT_STARTUP_TIMEOUT=180
# native：0 = 依片長自動（6 秒 -> 640，不低於 AUDIO_CONTEXT_MIN）；>0 固定值；1500 = 舊行為（補滿 30 秒）。
# resident（whisper-server）：0 仍是模型預設 1500。改值後請在自己的課堂錄音上重量 CER。
BREEZE_ASR_AUDIO_CONTEXT=0
BREEZE_ASR_AUDIO_CONTEXT_MIN=640
# native：BEST_OF 0 = 1（不產生多個候選）；BEAM_SIZE 0 = greedy。
BREEZE_ASR_BEAM_SIZE=0
BREEZE_ASR_BEST_OF=0
# native 解碼調校（optimization-round2）：關 temperature fallback、關 flash attention、
# max_tokens 0 = 依片長（6 秒 -> 68），重複迴圈時以 audio_ctx 1500 重跑一次。
BREEZE_ASR_TEMPERATURE_INC=0
BREEZE_ASR_FLASH_ATTN=0
BREEZE_ASR_MAX_TOKENS=0
BREEZE_ASR_REPEAT_GUARD=1
# 每段 print_timings + 啟動時 system_info，寫到輪替 log（5 MB x 3）；off = 丟棄。
BREEZE_ASR_TIMINGS=1
# BREEZE_ASR_LOG=%LOCALAPPDATA%\ZenBridge\logs\asr-worker.log
# Windows：worker 提到 ABOVE_NORMAL、關 EcoQoS（Linux 上不做任何事）。
BREEZE_ASR_PRIORITY=above_normal
BREEZE_ASR_ECOQOS_OFF=1
# VAD（BREEZE_VAD=silero）開著時，送辨識前先裁掉頭尾靜音（前後各留 PAD_MS）。
BREEZE_VAD_TRIM=1
BREEZE_VAD_TRIM_PAD_MS=200
BREEZE_GAP_WAIT=3
BREEZE_HISTORY_LIMIT=200
BREEZE_TOKEN_BUDGET=0
BREEZE_DATA_PATH=data/captions.sqlite3
# 價格必須同時有來源與日期，否則畫面只顯示用量，不顯示金額
# BREEZE 本身不讀價格；若要換算，請在程式外確認供應商價目後再填進翻譯設定
# 桌面捷徑預設會建立。以下設定保持註解，不改變預設行為。
# install_runtime 先讀行程環境變數，.env 只補尚未設定的鍵（app/settings.fill_process_environ）。
# 第一次安裝時 .env 還不存在，請設環境變數，不要只改這份範例。
# 設 1 略過桌面捷徑。
# BREEZE_SKIP_SHORTCUT=1
# 設 1 時捷徑失敗會讓安裝失敗；未設定時失敗仍可雙擊 start.bat。
# BREEZE_REQUIRE_SHORTCUT=1
