# 複製成 .env，不要提交 .env
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
BREEZE_TRANSLATE=1
BREEZE_PORT=8780
BREEZE_SHARE_SCHEME=http
BREEZE_SHARE_HOST=
BREEZE_MAX_AUDIO_BYTES=8388608
BREEZE_MAX_AUDIO_SECONDS=30
BREEZE_MAX_ROOMS=8
BREEZE_MAX_LISTENERS=40
BREEZE_MAX_QUEUE=8
BREEZE_MAX_INFLIGHT_BYTES=33554432
BREEZE_ASR=native
BREEZE_RESIDENT_URL=http://127.0.0.1:8178
BREEZE_RESIDENT_STARTUP_TIMEOUT=180
# 0 保留模型預設。512 為較短音訊的速度試驗設定；須重測中文準確度，不會自動套用。
BREEZE_ASR_AUDIO_CONTEXT=0
# 0 保留解碼預設；速度試驗可同時設 AUDIO_CONTEXT=512、BEAM_SIZE=1、BEST_OF=1。
BREEZE_ASR_BEAM_SIZE=0
BREEZE_ASR_BEST_OF=0
BREEZE_GAP_WAIT=3
BREEZE_HISTORY_LIMIT=200
BREEZE_TOKEN_BUDGET=0
BREEZE_DATA_PATH=data/captions.sqlite3
# 價格必須同時有來源與日期，否則畫面只顯示用量，不顯示金額
# BREEZE 本身不讀價格；若要換算，請在程式外確認供應商價目後再填進翻譯設定
# 桌面捷徑預設會建立。以下設定保持註解，不改變預設行為。
# install_runtime 先讀行程環境變數，.env 只補尚未設定的鍵（app/settings.fill_process_environ）。
# 第一次安裝時 .env 還不存在，請設環境變數，不要只改這份範例。
# 設 1 略過桌面捷徑。
# BREEZE_SKIP_SHORTCUT=1
# 設 1 時捷徑失敗會讓安裝失敗；未設定時失敗仍可雙擊 start.bat。
# BREEZE_REQUIRE_SHORTCUT=1
